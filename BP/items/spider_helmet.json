{
	"format_version": "1.20.80",
	"minecraft:item": {
		"description": {
			"identifier": "rg:spider_helmet", //id
			"menu_category": {
				"category": "equipment",
				"group": "itemGroup.name.helmet" //Grupo de los cascos
			}
		},
		"components": {
			"minecraft:max_stack_size": 1,
			"minecraft:enchantable": {
				"value": 9,
				"slot": "armor_head"
			},
			"minecraft:durability": {
				"max_durability": 100,
				"damage_chance": {
					"min": 100,
					"max": 100
				}
			},
			"minecraft:icon": "rg_spider_helmet",
			"minecraft:wearable": {
				"slot": "slot.armor.head",
				"protection": 2
			},
			"minecraft:repairable": {
				"repair_items": [
					{
						"items": [
							"minecraft:iron_ingot"
						],
						"repair_amount": "query.max_durability * 0.25"
					},
					{
						"items": [
							"minecraft:diamond"
						],
						"repair_amount": "query.max_durability * 0.25"
					},
					{
						"items": [
							"rg:spider_helmet"
						],
						"repair_amount": "context.other->query.remaining_durability + 0.12 * context.other->query.max_durability"
					}
				]
			}
		}
	}
}